{
  "name": "maplibre-gl-indoor",
  "description": "A MapLibre GL JS plugin for multi-floor indoor maps.",
  "version": "0.5.0",
  "main": "dist/lib/maplibre-gl-indoor.umd.js",
  "module": "dist/lib/maplibre-gl-indoor.es.js",
  "types": "dist/lib/maplibre-gl-indoor.d.ts",
  "files": [
    "dist"
  ],
  "private": false,
  "scripts": {
    "dev": "vite -c vite.examples.config.js",
    "build-lib": "tsc && vite build --emptyOutDir -c vite.lib.config.js",
    "build-examples": "tsc && vite build --emptyOutDir -c vite.examples.config.js",
    "serve": "vite preview",
    "lint": "eslint --ext .js,.ts src",
    "build-dts": "dts-bundle-generator -o dist/lib/maplibre-gl-indoor.d.ts src/index.ts",
    "prepublishOnly": "npm run build-lib && npm run build-examples && npm run build-dts",
    "prepare": "npm run build-lib && npm run build-dts"
  },
  "repository": "github:clement-igonet/maplibre-gl-indoor",
  "keywords": [
    "indoor",
    "building",
    "multi-level",
    "floors",
    "geojson",
    "map",
    "mapbox",
    "mapboxgl",
    "maplibre"
  ],
  "author": "Thibaud Michel",
  "license": "MIT",
  "peerDependencies": {
    "maplibre-gl": ">=4.0.0"
  },
  "devDependencies": {
    "@turf/centroid": "^6.5.0",
    "@types/geojson": "^7946.0.8",
    "@typescript-eslint/eslint-plugin": "^5.15.0",
    "@typescript-eslint/parser": "^5.15.0",
    "dts-bundle-generator": "^9.5.1",
    "eslint": "^8.11.0",
    "events": "^3.3.0",
    "osmtogeojson": "^3.0.0-beta.5",
    "typescript": "^5.6.0",
    "vite": "^6.4.3",
    "maplibre-gl": "^6.6.0"
  },
  "dependencies": {
    "@turf/bbox": "^6.5.0",
    "@turf/destination": "^6.5.0",
    "@turf/distance": "^6.5.0"
  },
  "exports": {
    ".": {
      "types": "./dist/lib/maplibre-gl-indoor.d.ts",
      "import": "./dist/lib/maplibre-gl-indoor.es.js",
      "require": "./dist/lib/maplibre-gl-indoor.umd.js"
    }
  }
}